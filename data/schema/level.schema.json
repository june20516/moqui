{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moqui.local/schema/level.schema.json",
  "title": "Level",
  "description": "레벨 데이터 (data/levels/stageNN.json): 방 참조 + 인간 + 기믹 + 시작 위치 + 시드 + 튜토리얼 (tech/architecture.md §5, spec/07).",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "room",
    "seed",
    "playerSpawn",
    "human"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^stage[0-9]{2}$"
    },
    "room": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "playerSpawn": {
      "$ref": "#/$defs/vector3"
    },
    "human": {
      "$ref": "#/$defs/human"
    },
    "dripSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position"
        ],
        "additionalProperties": false,
        "properties": {
          "position": {
            "$ref": "#/$defs/vector3"
          }
        }
      }
    },
    "humidZones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "center",
          "size",
          "strength"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "center": {
            "$ref": "#/$defs/vector3"
          },
          "size": {
            "$ref": "#/$defs/vector3"
          },
          "strength": {
            "enum": [
              "strong",
              "weak"
            ]
          }
        }
      }
    },
    "fans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "position",
          "yaw",
          "bodySize"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "yaw": {
            "type": "number"
          },
          "kind": {
            "enum": [
              "fan",
              "airConditioner"
            ],
            "description": "airConditioner: 방향 고정, 센 바람, 켜짐/꺼짐 주기 (M14)"
          },
          "schedule": {
            "type": "object",
            "required": [
              "on",
              "off"
            ],
            "additionalProperties": false,
            "properties": {
              "on": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "off": {
                "type": "number",
                "minimum": 0
              },
              "offset": {
                "type": "number"
              }
            }
          },
          "pitch": {
            "type": "number"
          },
          "bodySize": {
            "$ref": "#/$defs/vector3"
          }
        }
      }
    },
    "webs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "center",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "center": {
            "$ref": "#/$defs/vector3"
          },
          "size": {
            "$ref": "#/$defs/vector3"
          },
          "rotation": {
            "$ref": "#/$defs/vector3"
          }
        }
      }
    },
    "coils": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "position"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "$ref": "#/$defs/vector3"
          }
        }
      }
    },
    "sprayDispensers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "position"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "$ref": "#/$defs/vector3"
          }
        }
      }
    },
    "tutorial": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lights": {
      "type": "array",
      "description": "조명 스위치 (spec/06, M14)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "position",
          "area"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "area": {
            "type": "object",
            "required": [
              "center",
              "size"
            ],
            "additionalProperties": false,
            "properties": {
              "center": {
                "$ref": "#/$defs/vector3"
              },
              "size": {
                "$ref": "#/$defs/vector3"
              }
            }
          },
          "schedule": {
            "type": "object",
            "required": [
              "on",
              "off"
            ],
            "additionalProperties": false,
            "properties": {
              "on": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "off": {
                "type": "number",
                "minimum": 0
              },
              "offset": {
                "type": "number"
              }
            }
          },
          "onWhenAlert": {
            "type": "boolean"
          }
        }
      }
    },
    "nets": {
      "type": "array",
      "description": "모기장 그물 판 (spec/06, M14)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "center",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "center": {
            "$ref": "#/$defs/vector3"
          },
          "size": {
            "$ref": "#/$defs/vector3"
          }
        }
      }
    },
    "netGaps": {
      "type": "array",
      "description": "모기장 틈 볼륨 (spec/06, M14)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "center",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "center": {
            "$ref": "#/$defs/vector3"
          },
          "size": {
            "$ref": "#/$defs/vector3"
          }
        }
      }
    },
    "companions": {
      "type": "array",
      "description": "함께 있는 다른 인간들 (M14 두 사람). 형식은 human과 같고 id가 달라야 한다",
      "items": {
        "$ref": "#/$defs/human"
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "range": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "a",
        "b",
        "radius"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "head",
            "neck",
            "torso",
            "pelvis",
            "upperArm",
            "forearm",
            "hand",
            "thigh",
            "calf",
            "foot"
          ]
        },
        "a": {
          "$ref": "#/$defs/vector3"
        },
        "b": {
          "$ref": "#/$defs/vector3"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "site": {
          "enum": [
            "forearm",
            "calf",
            "footTop",
            "neck",
            "cheek"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "name",
        "weight",
        "duration",
        "motions"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "motions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "part",
              "offsetA",
              "offsetB"
            ],
            "additionalProperties": false,
            "properties": {
              "part": {
                "type": "string"
              },
              "offsetA": {
                "$ref": "#/$defs/vector3"
              },
              "offsetB": {
                "$ref": "#/$defs/vector3"
              }
            }
          }
        }
      }
    },
    "human": {
      "type": "object",
      "required": [
        "id",
        "position",
        "facingYaw",
        "head",
        "shoulders",
        "parts",
        "idle",
        "actions",
        "canSpray",
        "modifiers"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "facingYaw": {
          "type": "number"
        },
        "head": {
          "type": "string"
        },
        "shoulders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vector3"
          }
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "idle": {
          "type": "object",
          "required": [
            "lookYaws"
          ],
          "additionalProperties": false,
          "properties": {
            "lookYaws": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            },
            "glance": {
              "type": "object",
              "required": [
                "interval",
                "angle",
                "duration"
              ],
              "additionalProperties": false,
              "properties": {
                "interval": {
                  "$ref": "#/$defs/range"
                },
                "angle": {
                  "type": "number"
                },
                "duration": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "canSpray": {
          "type": "boolean"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "enum": [
              "doze",
              "drunk"
            ]
          },
          "uniqueItems": true
        },
        "facingPitch": {
          "type": "number",
          "description": "몸 전체 앞뒤 기울기(도). 90 = 누워서 위를 봄"
        },
        "restPitch": {
          "type": "number",
          "description": "평소 머리 피치(도, − 아래)"
        },
        "maxPosture": {
          "enum": [
            "arm",
            "lean",
            "turn",
            "rise"
          ],
          "description": "공격에 쓸 수 있는 가장 큰 몸동작 (기본 rise, D-053)"
        },
        "walk": {
          "type": "object",
          "description": "걷는 인간의 경로 (spec/02 §9, M14). 몸은 서 있는 자세로 정의한다",
          "required": [
            "route",
            "pause"
          ],
          "additionalProperties": false,
          "properties": {
            "route": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "pause": {
              "$ref": "#/$defs/range"
            },
            "loop": {
              "type": "boolean"
            }
          }
        },
        "tool": {
          "enum": [
            "none",
            "swatter"
          ],
          "description": "손에 든 도구 (전기 모기채, M14)"
        },
        "startBiteMarks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "시작할 때 이미 있는 물린 자국 수 (예민한 인간, M14)"
        }
      }
    }
  }
}
